# Project-level npm registry override.
#
# Why this exists (v1.25.1 Phase E): the maintainer's ~/.npmrc sets
# registry=https://registry.npmmirror.com (China mirror). When running
# `npm install` locally without an explicit --registry flag, npm picks
# up ~/.npmrc and writes the mirror URL into package-lock.json's
# "resolved" fields. Obsidian CI runs `npm install` on Linux with the
# default official registry; CI's lockfile resolution then produces a
# main.js with a different hash than the local release asset, triggering
# the "Build output does not match the released main.js artifact"
# warning that demotes the release score.
#
# Pinning this project to registry.npmjs.org locally keeps both lockfile
# trees consistent. This file overrides ~/.npmrc per-project (npm reads
# the project .npmrc first, then user config).
registry=https://registry.npmjs.org/

# Supply-chain hardening (Phase 1, task 1.4 — HARDENING-PLAN F-02/F-05).
#
# ignore-scripts: no package in the tree gets to run arbitrary code at
# install time. The dependency audit found only two lifecycle scripts in
# the whole graph — esbuild's `node install.js` (which validates and links
# the platform binary) and `ljharb-monorepo-symlink-test` (an eslint
# transitive with no legitimate need). Disabling all of them is the correct
# default; a compromised transitive then cannot execute on a contributor's
# machine or in CI just by being installed.
#
# Scope, precisely: BOTH npm and pnpm read this key, and it suppresses
# every lifecycle script — including pnpm's own `onlyBuiltDependencies`
# allowlist and this project's `prepare`. It is not an npm-only setting
# and pnpm-workspace.yaml does not carve an exception out of it. Verify
# after `pnpm install --frozen-lockfile`: `node_modules/.modules.yaml`
# lists `pendingBuilds: [., esbuild@0.28.2]` — i.e. esbuild's postinstall
# and the root `prepare` were both skipped.
#
# Nothing breaks, because esbuild no longer needs its postinstall to
# obtain a binary: the platform executable ships inside the
# `@esbuild/<platform>` optional dependency that pnpm installs normally,
# and `install.js` only validates/repairs it. `pnpm build` is verified
# working from an empty `node_modules` under this setting.
#
# Two escape hatches remain, in this order:
#   - pnpm: `onlyBuiltDependencies: [esbuild]` in pnpm-workspace.yaml is
#           the single-entry allowlist that takes effect if `ignore-scripts`
#           is ever relaxed. Keep it minimal.
#   - both: `node scripts/ensure-esbuild.mjs` runs esbuild's installer by
#           hand if a binary is ever missing. It is also wired as `prepare`
#           (inert while this key is set) and is a no-op when the binary is
#           already present, so running it twice costs nothing.
ignore-scripts=true

# The committed package-lock.json is generated with `--legacy-peer-deps`
# (HARDENING-PLAN task 1.1) because `eslint-plugin-obsidianmd` pulls
# `@microsoft/eslint-plugin-sdl`, whose `peer eslint@^9` conflicts with this
# project's eslint 10. Recording the flag here is what makes the lockfile
# reproducible: without it `npm ci` aborts with EUSAGE ("Missing:
# @codemirror/state ... from lock file") and a plain
# `npm install --package-lock-only` silently appends 57 lines of obsidian
# peer-dependency drift. Same class of defect as F-02 — a resolution setting
# that never propagated into the checked-in tree. pnpm does not use this key
# and ignores it.
legacy-peer-deps=true

# Fail `npm audit` on HIGH and CRITICAL. Mirrors the CI gate in
# .github/workflows/pr-ci.yml so a contributor sees locally what CI will
# enforce.
audit-level=high
